#!/bin/sh
set -e

case "$1" in
  configure)
    if ! getent group hovernet >/dev/null; then
      addgroup --system hovernet
    fi
    if ! getent passwd hovernet >/dev/null; then
      adduser --system --no-create-home --ingroup hovernet --home /nonexistent hovernet
    fi
    install -d -o hovernet -g hovernet -m 0750 /var/log/hovernet
    systemctl daemon-reload
    systemctl enable hovernet-raceserver
    # Reloading the unit file is not enough: an already-running process keeps
    # running the old binary until something restarts it. Without this, every
    # deploy installs a new .deb but silently leaves the old server running
    # (dpkg reports the new version; the live process disagrees) -- restart
    # unconditionally so an upgrade always takes effect, whether or not the
    # service was already running.
    systemctl restart hovernet-raceserver
    ;;
esac

#DEBHELPER#