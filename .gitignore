# Debug logs
*.log

# Personal/machine-local Claude Code settings (shared allowlist lives in .claude/settings.json)
.claude/settings.local.json

# Windows build output (regenerated fresh by CI; never commit build artifacts)
/Release/

# ImGui window-layout state, written to the working directory by any
# ImGui-based binary (Track3DViewer, Game2Player, the new
# ImGuiLogicalMouseSmoke test) run from the repo root
/imgui.ini
