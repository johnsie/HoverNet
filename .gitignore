*.pdb
**/*.pdb
NetTarget/**/Release/*.pdb
NetTarget/**/Debug/*.pdb

# The community track pack is a separate (~700 MB) download, never committed.
# Only its manifest (NetTarget/CommunityTracks.tsv) lives in the repository.
NetTarget/CommunityTracks/

