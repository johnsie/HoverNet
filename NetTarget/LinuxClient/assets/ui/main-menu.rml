<rml>
<head>
	<title>HoverNet</title>
	<link type="text/rcss" href="main-menu.rcss"/>
</head>
<body>
	<div id="hero"><img src="../menu-hovercraft-source.png"/></div>
	<div id="brand">
		<h1>HOVERNET</h1>
		<p class="coral">HIGH-SPEED COMBAT RACING</p>
		<div id="level">
			<p id="leveltext" class="coral"></p>
			<div class="bar"><div id="barfill"></div></div>
		</div>
	</div>
	<div id="panel">
		<p class="coral">READY TO RACE?</p>
		<hr/>
		<button id="online" class="primary">RACE ONLINE</button>
		<p class="pitch">Race real players. Climb the ranks.</p>
		<button id="offline" class="quiet primary">PRACTICE OFFLINE</button>
		<div class="grid">
			<button id="leaderboards">Leaderboards</button>
			<button id="garage">Garage</button>
			<button id="tutorial">Tutorial</button>
			<button id="settings" class="quiet">Settings</button>
		</div>
	</div>
	<p id="footer"><span id="version"></span></p>
</body>
</rml>
