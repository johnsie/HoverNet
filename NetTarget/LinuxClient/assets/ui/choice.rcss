body {
	font-family: Inter;
	font-size: 17dp;
	color: #f4f5f8;
	width: 100%;
	height: 100%;
}
p, h1, div { display: block; }
#brand { position: absolute; left: 54dp; top: 56dp; animation: 0.6s cubic-out fade-down; }
h1 { font-family: Oxanium; font-size: 46dp; font-weight: bold; margin: 0; }
.coral { color: #fa737a; font-size: 16dp; margin: 3dp 0; }
.dim { color: #8b8fa3; font-size: 15dp; margin: 3dp 0; }
@keyframes fade-down {
	from { opacity: 0; transform: translateY(-22dp); }
	to   { opacity: 1; transform: translateY(0dp); }
}
#panel {
	position: absolute;
	right: 38dp;
	top: 36dp;
	width: 430dp;
	padding: 20dp 22dp;
	background-color: #13131af5;
	border-radius: 10dp;
	animation: 0.55s cubic-out panel-in;
}
@keyframes panel-in {
	from { opacity: 0; transform: translateX(80dp); }
	to   { opacity: 1; transform: translateX(0dp); }
}
hr { height: 1dp; margin: 10dp 0 14dp 0; background-color: #303342; }
.group { color: #8b8fa3; font-size: 13dp; margin: 12dp 0 4dp 0; }
button {
	display: block;
	box-sizing: border-box;
	width: 100%;
	padding: 12dp 10dp;
	margin-bottom: 8dp;
	text-align: center;
	font-family: Oxanium;
	font-size: 18dp;
	font-weight: bold;
	color: #ffffff;
	background-color: #2b2e3e;
	tab-index: auto;
	cursor: pointer;
	transition: background-color transform 0.14s cubic-out;
}
button.primary { padding: 18dp 10dp; font-size: 22dp; background-color: #dc3546; }
button:hover, button:focus { background-color: #3a3e54; transform: scale(1.025); }
button.primary:hover, button.primary:focus { background-color: #f04a5b; }
button:active { transform: scale(0.97); }

.detail { font-family: Inter; font-size: 14dp; font-weight: normal; color: #cfd1de; }
button.primary .detail { color: #ffe3e6; }

scrollbarvertical { width: 12dp; }
scrollbarvertical slidertrack { width: 12dp; background-color: #1b1e2a; }
scrollbarvertical sliderbar { width: 12dp; min-height: 36dp; background-color: #3f4560; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0dp; height: 0dp; display: none; }
