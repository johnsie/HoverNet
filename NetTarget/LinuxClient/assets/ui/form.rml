<rml>
<head>
	<title>HoverNet</title>
	<link type="text/rcss" href="form.rcss"/>
</head>
<body>
	<div id="header"><p id="eyebrow">HOVERNET</p><h1 id="title">SETTINGS</h1></div>
	<div id="card">
		<div id="tabs"></div>
		<div id="fields"></div>
		<div id="side"></div>
	</div>
	<div id="footer">
		<button id="save" class="primary">Save</button>
		<button id="cancel" class="quiet">Cancel</button>
	</div>
	<div id="busy"><div id="busybox"><p id="busytitle"></p><p id="busyline"></p><div id="busybar"><div id="busyfill"></div></div><button id="busybutton" class="act quiet">Cancel</button></div></div>
</body>
</rml>
