body {
	font-family: Inter;
	font-size: 17dp;
	color: #f4f5f8;
	width: 100%;
	height: 100%;
}
p, h1, div { display: block; }

/* the craft, big on the left, drifting in */
#hero {
	position: absolute;
	left: 3%;
	bottom: 2%;
	width: 52%;
	height: 92%;
	animation: 0.9s cubic-out hero-in;
}
#hero img { width: 100%; height: 100%; }
@keyframes hero-in {
	from { opacity: 0; transform: translateX(-70dp) scale(0.96); }
	to   { opacity: 1; transform: translateX(0dp) scale(1); }
}

#brand { position: absolute; left: 48dp; top: 40dp; animation: 0.7s cubic-out fade-down; }
h1 { font-family: Oxanium; font-size: 46dp; font-weight: bold; margin: 0; }
.coral { color: #fa737a; font-size: 16dp; margin: 2dp 0; }
.dim { color: #8b8fa3; font-size: 15dp; margin: 2dp 0; }
@keyframes fade-down {
	from { opacity: 0; transform: translateY(-24dp); }
	to   { opacity: 1; transform: translateY(0dp); }
}

#level { margin-top: 14dp; width: 220dp; }
.bar { height: 6dp; margin-top: 4dp; background-color: #303342; border-radius: 3dp; }
#barfill { height: 6dp; width: 0%; background-color: #fa737a; border-radius: 3dp; transition: width 0.8s cubic-out; }

/* the panel, sliding in from the right */
#panel {
	position: absolute;
	right: 4%;
	top: 50%;
	margin-top: -320dp;
	width: 420dp;
	max-width: 42%;
	padding: 24dp 26dp;
	background-color: #13131ae8;
	border-radius: 12dp;
	animation: 0.65s cubic-out panel-in;
}
@keyframes panel-in {
	from { opacity: 0; transform: translateX(90dp); }
	to   { opacity: 1; transform: translateX(0dp); }
}
hr { height: 1dp; margin: 12dp 0 16dp 0; background-color: #303342; }

button {
	display: block;
	box-sizing: border-box;
	width: 100%;
	padding: 14dp 10dp;
	margin-bottom: 10dp;
	text-align: center;
	font-family: Oxanium;
	font-size: 18dp;
	font-weight: bold;
	color: #ffffff;
	background-color: #dc3546;
	decorator: gradient( vertical #e84659 #d32f43 );
	tab-index: auto;
	cursor: pointer;
	transition: background-color transform 0.14s cubic-out;
}
button.primary { padding: 22dp 10dp; font-size: 24dp; }
button.quiet { background-color: #2b2e3e; decorator: gradient( vertical #343849 #272a39 ); }
button:hover { background-color: #f04a5b; transform: scale(1.025); }
button.quiet:hover { background-color: #3a3e54; }
button:focus { background-color: #ff5a6c; transform: scale(1.025); }
button.quiet:focus { background-color: #4a4f6c; }
button:active { transform: scale(0.97); }
/* a soft red glow around the main button, breathing slowly */
.glow { padding: 5dp; margin: 0 -5dp 4dp -5dp; border-radius: 19dp; background-color: #dc354626; animation: 2.2s sine-in-out infinite glow-pulse; }
.glow button { margin-bottom: 0; }
@keyframes glow-pulse {
	from { background-color: #dc354622; }
	50%  { background-color: #dc354655; }
	to   { background-color: #dc354622; }
}
.eyebrow { font-family: Oxanium; font-size: 15dp; margin: 2dp 0 12dp 0; }
.glow { background-color: #dc354633; }

.pitch { color: #fa737a; font-size: 14dp; margin: 6dp 0 16dp 0; text-align: center; }
.grid { margin-top: 6dp; }
.grid button { display: inline-block; width: 48%; margin-right: 2%; font-size: 17dp; padding: 12dp 6dp; }
.grid button#garage, .grid button#settings { margin-right: 0; margin-left: 0; }
.hint { margin-top: 8dp; text-align: center; }

#footer { position: absolute; left: 22dp; bottom: 14dp; color: #6c7086; font-size: 13dp; }


/* the four smaller doors: dark tiles with a red tint, not another wall of red */
.grid button { background-color: #2a1c25; decorator: gradient( vertical #402533 #26171f ); border-color: #7a3546 #52283a #1f1217 #52283a; margin-bottom: 10dp; font-size: 17dp; }
.grid button:hover, .grid button:focus { background-color: #3a2230; decorator: gradient( vertical #56303f #33202a ); border-color: #fa737a; }
.grid button.quiet { background-color: #272a3a; decorator: gradient( vertical #323650 #1f2230 ); border-color: #4a4f6a #333750 #1a1c28 #333750; }
.grid button.quiet:hover, .grid button.quiet:focus { decorator: gradient( vertical #404668 #272b42 ); border-color: #fa737a; }

.hide { display: none; }
/* Quit: a plain, low key button under the doors, red only when pointed at */
button.quit { margin: 6dp 0 0 0; padding: 9dp 10dp; font-size: 15dp; color: #aeb2c6; background-color: #00000000; decorator: none; border-color: #2a2d40; }
button.quit:hover, button.quit:focus { color: #ffffff; background-color: #3a1c25; decorator: none; border-color: #fa737a; }

/* the Continue card: the last race, one click away */
#continue { margin: 0 0 14dp 0; padding: 14dp 16dp 4dp 16dp; border-radius: 12dp; background-color: #1b1522; decorator: gradient( vertical #2b1a2a #171220 ); border-width: 1dp; border-color: #5a2b3c; }
.cap { font-family: Oxanium; font-size: 13dp; color: #fa737a; margin: 0 0 2dp 0; }
.ctrack { font-family: Oxanium; font-size: 28dp; font-weight: bold; color: #ffffff; margin: 0; }
.cdetail { color: #aab0c8; font-size: 15dp; margin: 2dp 0 12dp 0; }
#continue button { margin-bottom: 10dp; }
